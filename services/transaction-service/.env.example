# Copy to .env and fill in real values. Never commit the filled-in file.

ASPNETCORE_ENVIRONMENT=Development

# Supavisor session-mode pooler for the Supabase project (xiuopwmaseuwaxikubxa),
# search_path scoped to the transaction_db schema. Use the pooler, not db.<ref>.supabase.co
# directly: the direct host is IPv6-only unless the project has the IPv4 add-on, and most
# local dev machines/CI runners have no IPv6 route to it.
ConnectionStrings__TransactionDb=Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xiuopwmaseuwaxikubxa;Password=CHANGE_ME;SearchPath=transaction_db

# JWT validation only — this service checks tokens issued by auth-service, it never issues
# its own. These three values must match auth-service's Jwt__* values exactly.
Jwt__Issuer=auth-service
Jwt__Audience=circular-economy-marketplace
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_BYTES

# gRPC: this service's own listen port, plus its 4 mesh peers' addresses (full-mesh plan,
# see /plans/pure-hugging-puzzle.md). Peer addresses point at localhost for bare `dotnet run`;
# docker-compose overrides these to the compose service names.
Grpc__Port=6002
Grpc__Peers__Auth=http://localhost:6001
Grpc__Peers__Messaging=http://localhost:6003
Grpc__Peers__Notification=http://localhost:6004
Grpc__Peers__Ai=http://localhost:6005

# Redis — one shared managed instance (e.g. Upstash/Redis Cloud), used for the wallet-balance/
# deal-lookup cache-aside layer. Same value as every other service's
# Redis__ConnectionString/REDIS_URL — one instance, namespaced by key prefix.
# StackExchange.Redis config-string format, e.g.: my-redis.upstash.io:6379,password=xxx,ssl=True,abortConnect=False
Redis__ConnectionString=CHANGE_ME
