# Copy to .env and fill in real values. Never commit the filled-in file.

ASPNETCORE_ENVIRONMENT=Development

# Supavisor session-mode pooler for your Supabase project (substitute your own project ref),
# search_path scoped to the auth_db schema. Use the pooler, not db.<ref>.supabase.co directly:
# the direct host is IPv6-only unless the project has the IPv4 add-on, and most local
# dev machines/CI runners have no IPv6 route to it.
ConnectionStrings__AuthDb=Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=CHANGE_ME;SearchPath=auth_db

# JWT signing
Jwt__Issuer=auth-service
Jwt__Audience=circular-economy-marketplace
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_BYTES
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Google Sign-In (ID-token verification flow: Client ID only, no secret needed)
Google__ClientId=CHANGE_ME.apps.googleusercontent.com

# Outbound email for verification codes and password-reset links (plain SMTP)
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__Username=CHANGE_ME
Smtp__Password=CHANGE_ME
Smtp__UseSsl=true
Smtp__FromAddress=no-reply@example.com
Smtp__FromName=Circular Economy Marketplace

# Email verification code settings
EmailVerification__CodeLength=6
EmailVerification__CodeExpiryMinutes=15

# gRPC — internal service-to-service mesh (REST above is untouched and unaffected by this)
Grpc__Port=6001
Grpc__Peers__Transaction=http://localhost:6002
Grpc__Peers__Messaging=http://localhost:6003
Grpc__Peers__Notification=http://localhost:6004
Grpc__Peers__Ai=http://localhost:6005

# Redis — one shared managed instance (e.g. Upstash/Redis Cloud), used for the vendor-profile/
# user-lookup cache-aside layer AND email-verification codes (replaces the Postgres
# email_verification table's expiry bookkeeping with native TTL). Same value as every other
# service's Redis__ConnectionString/REDIS_URL — one instance, namespaced by key prefix.
# StackExchange.Redis config-string format, e.g.: my-redis.upstash.io:6379,password=xxx,ssl=True,abortConnect=False
Redis__ConnectionString=CHANGE_ME

# Shared internal-mesh secret. Every service requires this on internal endpoints and on gRPC
# calls, which is what keeps the backend gRPC ports from being an unauthenticated way around the
# gateway (all end-user auth lives in the gateway). Must be IDENTICAL across every service and
# the gateway. Generate with: openssl rand -base64 32
Internal__ServiceToken=CHANGE_ME_SHARED_MESH_SECRET
