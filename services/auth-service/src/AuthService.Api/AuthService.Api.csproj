<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProtoRoot>$(MSBuildThisFileDirectory)..\..\..\..\proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.66.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.66.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- This service's own gRPC contract — server stubs. -->
    <Protobuf Include="$(ProtoRoot)\auth\v1\auth.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
    <!-- Peer contracts this service calls as a client — full mesh per the gRPC connectivity plan. -->
    <Protobuf Include="$(ProtoRoot)\transaction\v1\transaction.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Client" />
    <Protobuf Include="$(ProtoRoot)\messaging\v1\messaging.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Client" />
    <Protobuf Include="$(ProtoRoot)\notification\v1\notification.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Client" />
    <Protobuf Include="$(ProtoRoot)\ai\v1\ai.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthService.Infrastructure\AuthService.Infrastructure.csproj" />
    <ProjectReference Include="..\AuthService.Domain\AuthService.Domain.csproj" />
  </ItemGroup>

</Project>
