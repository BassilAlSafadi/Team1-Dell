# Copy to .env and fill in real values. Never commit the filled-in file.

NODE_ENV=development
PORT=8080

# MongoDB Atlas — stores conversations/messages for the messaging service. Use the
# "Connect your application" SRV string from Atlas (includes the username/password
# already); the driver resolves the replica set from the SRV record, so no host/port
# pair is needed like the pooler connection strings used by the Postgres services.
MONGODB_USERNAME=CHANGE_ME
MONGODB_PASSWORD=CHANGE_ME
MONGODB_URI=CHANGE_ME
MONGO_DB_NAME=messaging_db

# JWT verification — must match the signing key auth-service issues access tokens
# with (Jwt__Issuer / Jwt__Audience / Jwt__SigningKey in auth-service's .env), since
# this service verifies the same tokens rather than minting its own.
JWT_ISSUER=auth-service
JWT_AUDIENCE=circular-economy-marketplace
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_BYTES

# Comma-separated list of allowed CORS origins (the gateway/frontend origin(s)).
CORS_ORIGINS=http://localhost:3000

# gRPC — internal service-to-service mesh (separate from the PORT above, which stays REST-only).
# Peer addresses are bare host:port. For local dev / same-host docker-compose, that's localhost.
# Once peers are deployed behind their own Cloudflare Tunnel (see /infra/cloudflare-tunnel),
# point these at each peer's internal tunnel hostname (e.g. auth-internal.<your-domain>:443)
# and set GRPC_USE_TLS=true so outbound calls negotiate TLS instead of plaintext.
GRPC_PORT=6003
GRPC_USE_TLS=false
AUTH_GRPC_ADDR=localhost:6001
TRANSACTION_GRPC_ADDR=localhost:6002
NOTIFICATION_GRPC_ADDR=localhost:6004
AI_GRPC_ADDR=localhost:6005

# Redis — one shared managed instance (e.g. Upstash/Redis Cloud), used for the conversation
# cache-aside layer. Same value as every other service's REDIS_URL/Redis__ConnectionString.
# Full connection string, e.g.: rediss://default:xxx@my-redis.upstash.io:6379
REDIS_URL=CHANGE_ME

# Shared internal-mesh secret. Every service requires this on internal endpoints and on gRPC
# calls, which is what keeps the backend gRPC ports from being an unauthenticated way around the
# gateway (all end-user auth lives in the gateway). Must be IDENTICAL across every service and
# the gateway. Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=CHANGE_ME_SHARED_MESH_SECRET
