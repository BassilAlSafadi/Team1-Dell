# Copy to .env and fill in real values. Never commit the filled-in file.

# Gemini (Google Generative AI) — used both as the chat LLM and for OCR-transcribing
# the scanned Arabic law PDF during ingestion.
GEMINI_API_KEY=CHANGE_ME
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: only needed if EMBEDDING_MODEL_NAME below is switched to a gated/private
# Hugging Face model. The default model is public, downloads locally, and needs no token.
HUGGINGFACEHUB_API_TOKEN=

# Runs locally via sentence-transformers, no API calls per query. Multilingual because
# the two knowledge bases are Arabic (the law) and English (the recycling guide).
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
