# Copy to .env and fill in real values. Never commit the filled-in file.

# Gemini (Google Generative AI) — used both as the chat LLM and for OCR-transcribing
# the scanned Arabic law PDF during ingestion.
# GEMINI_API_KEY is always the first key tried. GEMINI_API_KEY_FALLBACK, then
# GEMINI_API_KEY_FALLBACK_2, _3, ... (up to _10) are tried in order if a key fails with an
# auth-type error (see gemini_keys.py). Leave the fallbacks blank to use only the primary.
GEMINI_API_KEY=CHANGE_ME
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_FALLBACK_2=
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Required: embeddings run through the hosted HF Inference API (HuggingFaceEndpointEmbeddings),
# not a local model — keeps torch/sentence-transformers out of the image. Get a token at
# https://huggingface.co/settings/tokens (read scope is enough).
HUGGINGFACEHUB_API_TOKEN=

# Embedding model, called via the HF Inference API (task=feature-extraction). Multilingual
# because the two knowledge bases are Arabic (the law) and English (the recycling guide).
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# MongoDB Atlas — stores chat threads/messages and waste classifier/recommendation
# history. Use the "Connect your application" SRV string from Atlas (includes the
# username/password already); the driver resolves the replica set from the SRV record,
# so no host/port pair is needed like the pooler connection strings in other services.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# ai-service has no auth layer yet, so chat/classification/recommendation history
# is attached to this single id instead of a real logged-in user. Once
# auth-service's users table is seeded, set this to a real user's uuid
# (users.user_id) so the history lines up with an actual seeded account.
DEMO_USER_ID=

# gRPC — ai-service's first long-running server (see grpc_server.py). GRPC_PORT is
# this service's own listen port; MESH_HTTP_PORT serves GET /internal/mesh/status
# (a stdlib HTTP server, since this service has no REST framework of its own) fanning
# out grpc.health.v1.Health/Check to the 4 peers below.
GRPC_PORT=6005
MESH_HTTP_PORT=7005
# Peer addresses are bare host:port. For local dev / same-host docker-compose, that's localhost.
# Once peers are deployed behind their own Cloudflare Tunnel (see /infra/cloudflare-tunnel),
# point these at each peer's internal tunnel hostname (e.g. auth-internal.<your-domain>:443)
# and set GRPC_USE_TLS=true so outbound calls negotiate TLS instead of plaintext.
GRPC_USE_TLS=false
AUTH_GRPC_ADDR=localhost:6001
TRANSACTION_GRPC_ADDR=localhost:6002
MESSAGING_GRPC_ADDR=localhost:6003
NOTIFICATION_GRPC_ADDR=localhost:6004

# Redis — one shared managed instance (e.g. Upstash/Redis Cloud), used for the vendor-search
# cache-aside layer. Same value as every other service's REDIS_URL/Redis__ConnectionString.
# Full connection string, e.g.: rediss://default:xxx@my-redis.upstash.io:6379
REDIS_URL=CHANGE_ME

# Shared internal-mesh secret. Every service requires this on internal endpoints and on gRPC
# calls, which is what keeps the backend gRPC ports from being an unauthenticated way around the
# gateway (all end-user auth lives in the gateway). Must be IDENTICAL across every service and
# the gateway. Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=CHANGE_ME_SHARED_MESH_SECRET
