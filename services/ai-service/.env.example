# Copy to .env and fill in real values. Never commit the filled-in file.

# Gemini (Google Generative AI) — used both as the chat LLM and for OCR-transcribing
# the scanned Arabic law PDF during ingestion.
GEMINI_API_KEY=CHANGE_ME
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: only needed if EMBEDDING_MODEL_NAME below is switched to a gated/private
# Hugging Face model. The default model is public, downloads locally, and needs no token.
HUGGINGFACEHUB_API_TOKEN=

# Runs locally via sentence-transformers, no API calls per query. Multilingual because
# the two knowledge bases are Arabic (the law) and English (the recycling guide).
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# MongoDB Atlas — stores chat threads/messages and waste classifier/recommendation
# history. Use the "Connect your application" SRV string from Atlas (includes the
# username/password already); the driver resolves the replica set from the SRV record,
# so no host/port pair is needed like the pooler connection strings in other services.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# ai-service has no auth layer yet, so chat/classification/recommendation history
# is attached to this single id instead of a real logged-in user. Once
# auth-service's users table is seeded, set this to a real user's uuid
# (users.user_id) so the history lines up with an actual seeded account.
DEMO_USER_ID=