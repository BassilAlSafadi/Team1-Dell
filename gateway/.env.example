# Copy to .env and fill in real values. Never commit the filled-in file.

PORT=8080

# JWT — validated at the edge (see IMPLEMENTATION_PLAN.md §4.2). Must match auth-service's
# Jwt__Issuer/Jwt__Audience/Jwt__SigningKey exactly — same shared secret every service trusts.
JWT_ISSUER=auth-service
JWT_AUDIENCE=circular-economy-marketplace
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_BYTES

CORS_ORIGINS=http://localhost:3000

# gRPC — backend addresses for the routes that already have a real gRPC RPC (see the routing
# table in IMPLEMENTATION_PLAN.md §4.1).
AUTH_GRPC_ADDR=localhost:6001
TRANSACTION_GRPC_ADDR=localhost:6002
MESSAGING_GRPC_ADDR=localhost:6003
NOTIFICATION_GRPC_ADDR=localhost:6004
AI_GRPC_ADDR=localhost:6005

# REST reverse-proxy fallback — for every route whose backend gRPC RPC doesn't exist yet
# (decision (a): gateway-first, expand-as-you-go). ai-service has no REST API, so no entry here
# — its routes only ever go through gRPC.
AUTH_REST_ADDR=localhost:8080
TRANSACTION_REST_ADDR=localhost:8080
MESSAGING_REST_ADDR=localhost:8080
NOTIFICATION_REST_ADDR=localhost:8080

# Redis — same shared managed instance every other service uses (e.g. Upstash/Redis Cloud),
# used for the rate-limit counters under the `ratelimit:` key prefix (see ../REDIS_INTEGRATION_PLAN.md).
# Full connection string, e.g.: rediss://default:xxx@my-redis.upstash.io:6379
REDIS_URL=CHANGE_ME

# Token-bucket rate limit, per client (authenticated user id, falling back to client IP).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
