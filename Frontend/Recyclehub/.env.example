# Copy to .env.local (or .env) and fill in real values.

# Gateway base URL. Defaults to http://localhost:8080 if unset.
VITE_API_BASE_URL=http://localhost:8080

# Google Sign-In OAuth client ID (Web application type). Must match the audience
# the auth-service validates against (Google__ClientId in services/auth-service/.env).
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
