.env

# .NET build output
bin/
obj/

# Python
__pycache__/
*.pyc
.venv/

# ai-service RAG data: PDFs, OCR cache and vector store are regenerable/large and
# shouldn't be committed. See services/ai-service/data/source_pdfs/README.md.
services/ai-service/data/source_pdfs/*.pdf
services/ai-service/data/ocr_cache/
services/ai-service/data/vector_store/

# Node.js
node_modules/
npm-debug.log*

# Go
services/notification-service/notification-service
services/notification-service/*.exe

# run-services.sh output
/logs/

# Tool caches — regenerable, shouldn't be tracked
.pytest_cache/
.ruff_cache/
*.log
